{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "*": [
                "./src/*"
            ]
        },
        "jsx": "react-native",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "types": ["node"],
        "noUnusedLocals": true,
        "noUnusedParameters": true
    }
}
