# Override these only if you don't want the app to auto-detect the Expo dev server host.
EXPO_PUBLIC_NOTES_API_HOST=10.0.2.2
EXPO_PUBLIC_NOTES_API_PORT=8000
# Публичная ссылка для Claude Gateway (например, ngrok)
EXPO_PUBLIC_GATEWAY_API_BASE_URL=https://your-public-gateway-url.ngrok-free.app
# Публичная ссылка для Auth Service (например, https://auth.vaultonote.com)
EXPO_PUBLIC_AUTH_API_BASE_URL=https://your-auth-domain.ngrok-free.app
EXPO_PUBLIC_AUTH_AUDIENCE=vaulto_note_mobile

# Google Auth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# For Expo Go Proxy (Optional override if auto-detect fails)
# EXPO_PUBLIC_REDIRECT_URI=https://auth.expo.io/@your-username/your-app-slug

# RevenueCat Test Store key (test_...), used only in __DEV__ builds
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
