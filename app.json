{
  "expo": {
    "name": "Vaulto Note",
    "slug": "vaulto-note-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to the microphone to record voice notes."
      },
      "bundleIdentifier": "com.anonymous.vaultonotemobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.vaultonotemobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vaultonote",
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow Vaulto Note to access your microphone to record voice notes."
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "436d06a9-6cc0-4f21-84d3-70594056fd63"
      }
    }
  }
}
