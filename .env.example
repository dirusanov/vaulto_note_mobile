# Expo exposes every EXPO_PUBLIC_* value in the client bundle.
# Never put server API secrets, signing passwords, or private keys here.

# Local development services. Use your computer's LAN IP for a physical phone.
EXPO_PUBLIC_GATEWAY_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_AUTH_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_AUTH_AUDIENCE=vaulto_note_mobile

# Optional: configure these for your own Google sign-in / RevenueCat projects.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
